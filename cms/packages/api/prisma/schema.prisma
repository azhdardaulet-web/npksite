// НПК CMS — Prisma Schema
// PostgreSQL 16 + Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  CHIEF_EDITOR
  SECTION_EDITOR
  RECEPTION_MANAGER
  DEPUTY
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum NewsStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  SCHEDULED
}

enum NewsFormat {
  news
  party_release
  article
  analytics
  interview
}

enum MediaType {
  image
  video
  pdf
  document
}

enum DocumentType {
  ustav
  deputy_request
  press_kit
  appeal_sample
  other
}

enum Lang {
  ru
  kz
}

enum TeamMemberGroup {
  LEADERSHIP
  MEDIA_TEAM
  FACTION
}

// ─── CRM enums ─────────────────────────────────────────────────────────────────

enum JoinRequestRole {
  member
  volunteer
  observer
}

enum Gender {
  male
  female
}

enum JoinRequestStatus {
  NEW
  PROCESSING
  ACCEPTED
  REJECTED
}

enum AppealStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  REJECTED
}

// Формат обращения — гражданин выбирает на /priemnaya. VIDEO помечает
// обращения, для которых менеджер приёмной должен назначить видеозвонок
// (см. AppealMeeting) — без этого поля их не отличить от письменных.
enum AppealFormat {
  WRITTEN
  VIDEO
}

// Статус видеозвонка. PENDING — менеджер выбрал депутата/время, но вызов
// Google Calendar API ещё не подключён/не выполнен (см.
// cms/packages/api/src/lib/googleCalendar.ts, docs/GOOGLE_MEET_SETUP.md).
// SCHEDULED — событие реально создано, meetLink заполнен.
enum MeetingStatus {
  PENDING
  SCHEDULED
  CANCELLED
}

// ─── Users & Auth ─────────────────────────────────────────────────────────────

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String
  passwordHash  String
  role          Role
  status        UserStatus     @default(ACTIVE)
  branchId      String?
  branch        Branch?        @relation(fields: [branchId], references: [id])
  section       String?
  refreshTokens RefreshToken[]
  news          News[]
  media         Media[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([email])
  @@index([role])
  @@index([branchId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tokenHash])
}

// ─── News ─────────────────────────────────────────────────────────────────────

model News {
  id           String            @id @default(uuid())
  slug         String            @unique
  format       NewsFormat
  status       NewsStatus        @default(DRAFT)
  imageUrl     String?
  isFeatured   Boolean           @default(false)
  readingTime  Int?
  tags         String[]          @default([])
  tgPosted     Boolean           @default(false)
  tgSkip       Boolean           @default(false)
  publishedAt  DateTime?
  scheduledAt  DateTime?
  authorId     String
  author       User              @relation(fields: [authorId], references: [id])
  translations NewsTranslation[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([status])
  @@index([format])
  @@index([publishedAt])
  @@index([slug])
}

model NewsTranslation {
  id             String   @id @default(uuid())
  newsId         String
  news           News     @relation(fields: [newsId], references: [id], onDelete: Cascade)
  lang           Lang
  title          String
  excerpt        String?
  content        String   // Rich text HTML from TipTap
  seoTitle       String?
  seoDescription String?
  seoKeywords    String?
  ogImageUrl     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([newsId, lang])
  @@index([newsId])
  @@index([lang])
}

// ─── Media Library ────────────────────────────────────────────────────────────

model GalleryFolder {
  id        String          @id @default(uuid())
  name      String
  parentId  String?
  parent    GalleryFolder?  @relation("FolderTree", fields: [parentId], references: [id])
  children  GalleryFolder[] @relation("FolderTree")
  media     Media[]
  gallery   Gallery[]
  createdAt DateTime        @default(now())

  @@index([parentId])
}

model Media {
  id            String         @id @default(uuid())
  name          String         // UUID-based filename
  originalName  String         // Original upload filename
  url           String         // MinIO public URL
  thumbnailUrl  String?        // Thumbnail for images
  type          MediaType
  mimeType      String
  size          Int            // Bytes
  folderId      String?
  folder        GalleryFolder? @relation(fields: [folderId], references: [id])
  uploadedById  String
  uploadedBy    User           @relation(fields: [uploadedById], references: [id])
  gallery       Gallery[]
  createdAt     DateTime       @default(now())

  @@index([folderId])
  @@index([type])
  @@index([uploadedById])
}

model Gallery {
  id         String         @id @default(uuid())
  mediaId    String
  media      Media          @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  type       String         // "photo" | "video"
  title      String
  duration   String?        // e.g. "3:45" for videos
  sortOrder  Int            @default(0)
  folderId   String?
  folder     GalleryFolder? @relation(fields: [folderId], references: [id])
  createdAt  DateTime       @default(now())

  @@index([folderId])
  @@index([sortOrder])
}

// ─── Team (Руководство / Народное медиа) ──────────────────────────────────────

model TeamMember {
  id           String                  @id @default(uuid())
  photoUrl     String?
  email        String?                 // нужен депутатам (group=FACTION) — приглашение на Google Meet
  slug         String?                 @unique // для персональной страницы /rukovodstvo/:slug (LEADERSHIP)
  group        TeamMemberGroup         @default(LEADERSHIP)
  sortOrder    Int                     @default(0)
  translations TeamMemberTranslation[]
  meetings     AppealMeeting[]
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@index([sortOrder])
  @@index([group])
}

model TeamMemberTranslation {
  id        String     @id @default(uuid())
  memberId  String
  member    TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  lang      Lang
  name      String
  position  String
  bio       String?
  // Полное резюме (образование, карьера) — показывается в модалке при клике на карточку;
  // bio выше — короткая подпись под именем в самой карточке.
  fullBio   String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([memberId, lang])
}

// ─── Documents (Устав, депутатские запросы, пресс-кит) ────────────────────────

model Document {
  id          String       @id @default(uuid())
  title       String       // русская версия и fallback для старых документов
  description String?      // русская версия и fallback для старых документов
  titleKz       String?
  descriptionKz String?
  type        DocumentType
  fileUrl     String
  fileName    String
  fileSize    Int
  year        Int?
  publishedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([type])
  @@index([year])
}

// ─── Pages (CMS-managed static pages) ────────────────────────────────────────

model Page {
  id           String            @id @default(uuid())
  slug         String            @unique // "home" | "about" | "faction" | "contacts" | ...
  isPublished  Boolean           @default(true)
  blocks       PageBlock[]
  translations PageTranslation[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([slug])
}

model PageBlock {
  id        String   @id @default(uuid())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type      String   // hero | text_image | kpi | quote | pdf_list | contacts_block
  sortOrder Int
  content   Json     // Per-block-type JSON structure
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageId, sortOrder])
}

model PageTranslation {
  id             String   @id @default(uuid())
  pageId         String
  page           Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  lang           Lang
  title          String
  seoTitle       String?
  seoDescription String?
  ogImageUrl     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([pageId, lang])
  @@index([pageId])
}

// ─── App Settings ─────────────────────────────────────────────────────────────

model Setting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  userName  String
  userRole  String
  action    String
  entity    String
  entityId  String?
  details   String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([entity])
}

// ─── Branches / Филиалы (было Office) ─────────────────────────────────────────

model Branch {
  id           String         @id @default(uuid())
  cityRu       String
  cityKz       String
  addressRu    String
  addressKz    String
  phone        String
  email        String
  department   String?
  chairman     String?
  lng          Float?
  lat          Float?
  sortOrder    Int            @default(0)
  users        User[]
  joinRequests JoinRequest[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([sortOrder])
}

// ─── CRM: Заявки на вступление ─────────────────────────────────────────────────

model JoinRequest {
  id            String            @id @default(uuid())
  role          JoinRequestRole   @default(member)
  fullName      String
  birthDate     DateTime?
  gender        Gender?
  // ИИН и номер удостоверения — персональные данные, наравне с телефоном/email
  // видны в админке только роли ADMIN (см. join-requests.controller.ts requireCms).
  iin           String?
  idDocNumber   String?
  address       String?
  phone         String
  email         String?
  city          String?
  branchId      String?
  branch        Branch?           @relation(fields: [branchId], references: [id])
  status        JoinRequestStatus @default(NEW)
  phoneVerified Boolean           @default(false)
  merchAddress  String?
  memberNumber  String?           @unique
  fullNameKz    String?
  fullNameRu    String?
  joinDate      DateTime?         @db.Date
  cardFileUrl   String?
  verifyUuid    String            @unique @default(uuid()) @db.Uuid
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([status])
  @@index([phone])
  @@index([branchId])
  @@index([createdAt])
}

// ─── CRM: Обращения граждан ────────────────────────────────────────────────────

model AppealTopic {
  id        String   @id @default(uuid())
  nameRu    String
  nameKz    String
  sortOrder Int      @default(0)
  appeals   Appeal[]
  createdAt DateTime @default(now())

  @@index([sortOrder])
}

model Appeal {
  id            String        @id @default(uuid())
  appealNumber  String        @unique
  fullName      String
  phone         String
  email         String?
  topicId       String
  topic         AppealTopic   @relation(fields: [topicId], references: [id])
  message       String        @db.Text
  fileUrl       String?
  attachments   Json?
  format        AppealFormat  @default(WRITTEN)
  status        AppealStatus  @default(NEW)
  internalNotes String?       @db.Text
  meeting       AppealMeeting?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status])
  @@index([appealNumber])
  @@index([createdAt])
  @@index([format])
}

// Видеозвонок (Google Meet) по обращению format=VIDEO. Одно обращение —
// максимум одна активная запись (appealId уникален): переназначение
// перезаписывает deputyId/scheduledAt и сбрасывает статус в PENDING.
// meetLink/calendarEventId заполняются только после успешного вызова
// createGoogleMeetEvent() — до подключения интеграции остаются null,
// а status — PENDING (см. googleCalendar.ts, docs/GOOGLE_MEET_SETUP.md).
model AppealMeeting {
  id               String        @id @default(uuid())
  appealId         String        @unique
  appeal           Appeal        @relation(fields: [appealId], references: [id], onDelete: Cascade)
  deputyId         String
  deputy           TeamMember    @relation(fields: [deputyId], references: [id])
  scheduledAt      DateTime
  durationMinutes  Int           @default(30)
  status           MeetingStatus @default(PENDING)
  meetLink         String?
  calendarEventId  String?
  lastError        String?       @db.Text
  reminderSentAt   DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([status])
  @@index([scheduledAt])
}

// ─── CRM: SMS-верификация ───────────────────────────────────────────────────────

model SmsCode {
  id        String   @id @default(uuid())
  phone     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([phone])
  @@index([createdAt])
}

// ─── Магазин (email-подписка на открытие) ──────────────────────────────────────

model ShopSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// ─── Кандидаты ──────────────────────────────────────────────────────────────────

model Candidate {
  id           String                 @id @default(uuid())
  name         String
  region       String
  district     String?
  photoUrl     String?
  sortOrder    Int                    @default(0)
  translations CandidateTranslation[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([sortOrder])
  @@index([region])
}

model CandidateTranslation {
  id          String    @id @default(uuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  lang        Lang
  promise     String    @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([candidateId, lang])
}

// ─── История партии ──────────────────────────────────────────────────────────────

model HistoryEvent {
  id           String                    @id @default(uuid())
  year         Int
  imageUrl     String?
  sortOrder    Int                       @default(0)
  translations HistoryEventTranslation[]
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  @@index([sortOrder])
  @@index([year])
}

model HistoryEventTranslation {
  id             String       @id @default(uuid())
  historyEventId String
  historyEvent   HistoryEvent @relation(fields: [historyEventId], references: [id], onDelete: Cascade)
  lang           Lang
  title          String
  text           String       @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([historyEventId, lang])
}

// ─── Программа партии ────────────────────────────────────────────────────────────

model ProgramBlock {
  id           String                    @id @default(uuid())
  n            Int
  keyword      String
  imageUrl     String?
  sortOrder    Int                       @default(0)
  translations ProgramBlockTranslation[]
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  @@index([sortOrder])
}

model ProgramBlockTranslation {
  id             String       @id @default(uuid())
  programBlockId String
  programBlock   ProgramBlock @relation(fields: [programBlockId], references: [id], onDelete: Cascade)
  lang           Lang
  title          String
  lead1          String?
  lead2          String?
  points         Json // string[] по языку
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([programBlockId, lang])
}

// ─── Медиапроекты (карточки /media) ──────────────────────────────────────────────

model MediaProject {
  id           String                   @id @default(uuid())
  tag          String
  url          String?
  imageUrl     String?
  sortOrder    Int                      @default(0)
  translations MediaProjectTranslation[]
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@index([sortOrder])
}

model MediaProjectTranslation {
  id             String       @id @default(uuid())
  mediaProjectId String
  mediaProject   MediaProject @relation(fields: [mediaProjectId], references: [id], onDelete: Cascade)
  lang           Lang
  title          String
  description    String       @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([mediaProjectId, lang])
}

// ─── СМИ о нас ────────────────────────────────────────────────────────────────────

model MediaPublication {
  id         String   @id @default(uuid())
  date       DateTime
  sourceType String
  mediaName  String
  title      String
  excerpt    String?
  imageUrl   String?
  url        String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([sortOrder])
  @@index([date])
}

// ─── Отзывы ───────────────────────────────────────────────────────────────────────

model Testimonial {
  id        String   @id @default(uuid())
  quote     String   @db.Text
  author    String
  approved  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

// ─── Меню сайта ───────────────────────────────────────────────────────────────────

model MenuItem {
  id        String     @id @default(uuid())
  labelRu   String
  labelKz   String
  href      String
  parentId  String?
  parent    MenuItem?  @relation("MenuTree", fields: [parentId], references: [id])
  children  MenuItem[] @relation("MenuTree")
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([parentId])
  @@index([sortOrder])
}

// ─── FAQ (база знаний чат-бота) ───────────────────────────────────────────────────

model Faq {
  id        String   @id @default(uuid())
  question  String
  answer    String   @db.Text
  lang      Lang
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lang])
  @@index([sortOrder])
}
