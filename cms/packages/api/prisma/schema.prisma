// DAR Rail CMS — Prisma Schema
// PostgreSQL 16 + Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  NEWS_EDITOR
  PROCUREMENT_MANAGER
  CONTENT_MANAGER
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum NewsType {
  press
  article
  media_mention
}

enum NewsCategory {
  corporate
  industry
  safety
  hr
  esg
  financial
}

enum NewsStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  SCHEDULED
}

enum MediaType {
  image
  video
  pdf
  document
}

enum SupplierFormStatus {
  NEW
  IN_PROGRESS
  DONE
}

enum DocumentType {
  service_contract
  supply_contract
  purchases_plan
  other
}

enum VacancyStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum ResumeStatus {
  NEW
  REVIEWED
  INVITED
  REJECTED
}

enum Lang {
  ru
  kz
  en
  zh
}

// ─── Users & Auth ─────────────────────────────────────────────────────────────

model User {
  id            String     @id @default(uuid())
  email         String     @unique
  name          String
  passwordHash  String
  role          Role
  status        UserStatus @default(ACTIVE)
  refreshTokens RefreshToken[]
  news          News[]
  media         Media[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([email])
  @@index([role])
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tokenHash])
}

// ─── News ─────────────────────────────────────────────────────────────────────

model News {
  id           String        @id @default(uuid())
  slug         String        @unique
  type         NewsType
  category     NewsCategory
  status       NewsStatus    @default(DRAFT)
  imageUrl     String?
  isFeatured   Boolean       @default(false)
  readingTime  Int?
  publishedAt  DateTime?
  scheduledAt  DateTime?
  authorId     String
  author       User          @relation(fields: [authorId], references: [id])
  translations NewsTranslation[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status])
  @@index([type])
  @@index([category])
  @@index([publishedAt])
  @@index([slug])
}

model NewsTranslation {
  id             String   @id @default(uuid())
  newsId         String
  news           News     @relation(fields: [newsId], references: [id], onDelete: Cascade)
  lang           Lang
  title          String
  excerpt        String?
  content        String   // Rich text HTML from TipTap
  seoTitle       String?
  seoDescription String?
  ogImageUrl     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([newsId, lang])
  @@index([newsId])
  @@index([lang])
}

// ─── Media Library ────────────────────────────────────────────────────────────

model GalleryFolder {
  id        String          @id @default(uuid())
  name      String
  parentId  String?
  parent    GalleryFolder?  @relation("FolderTree", fields: [parentId], references: [id])
  children  GalleryFolder[] @relation("FolderTree")
  media     Media[]
  gallery   Gallery[]
  createdAt DateTime        @default(now())

  @@index([parentId])
}

model Media {
  id            String         @id @default(uuid())
  name          String         // UUID-based filename
  originalName  String         // Original upload filename
  url           String         // MinIO public URL
  thumbnailUrl  String?        // Thumbnail for images
  type          MediaType
  mimeType      String
  size          Int            // Bytes
  folderId      String?
  folder        GalleryFolder? @relation(fields: [folderId], references: [id])
  uploadedById  String
  uploadedBy    User           @relation(fields: [uploadedById], references: [id])
  gallery       Gallery[]
  createdAt     DateTime       @default(now())

  @@index([folderId])
  @@index([type])
  @@index([uploadedById])
}

model Gallery {
  id         String         @id @default(uuid())
  mediaId    String
  media      Media          @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  type       String         // "photo" | "video"
  title      String
  duration   String?        // e.g. "3:45" for videos
  sortOrder  Int            @default(0)
  folderId   String?
  folder     GalleryFolder? @relation(fields: [folderId], references: [id])
  createdAt  DateTime       @default(now())

  @@index([folderId])
  @@index([sortOrder])
}

// ─── Services ─────────────────────────────────────────────────────────────────

model Service {
  id           String               @id @default(uuid())
  iconName     String
  imageUrl     String?
  sortOrder    Int                  @default(0)
  translations ServiceTranslation[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([sortOrder])
}

model ServiceTranslation {
  id          String   @id @default(uuid())
  serviceId   String
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  lang        Lang
  title       String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([serviceId, lang])
}

// ─── Partners ─────────────────────────────────────────────────────────────────

model Partner {
  id         String   @id @default(uuid())
  name       String
  logoUrl    String
  websiteUrl String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([sortOrder])
}

// ─── Clients (секция «Наши клиенты» на главной) ───────────────────────────────

model Client {
  id         String   @id @default(uuid())
  name       String
  logoUrl    String
  websiteUrl String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([sortOrder])
}

// ─── Team ─────────────────────────────────────────────────────────────────────

model TeamMember {
  id           String                  @id @default(uuid())
  photoUrl     String?
  sortOrder    Int                     @default(0)
  translations TeamMemberTranslation[]
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@index([sortOrder])
}

model TeamMemberTranslation {
  id       String     @id @default(uuid())
  memberId String
  member   TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  lang     Lang
  name     String
  position String
  bio      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([memberId, lang])
}

// ─── Documents ────────────────────────────────────────────────────────────────

model Document {
  id          String       @id @default(uuid())
  title       String
  description String?
  type        DocumentType
  fileUrl     String
  fileName    String
  fileSize    Int
  year        Int?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([type])
  @@index([year])
}

// ─── Purchases Plan ───────────────────────────────────────────────────────────

model PurchaseItem {
  id               String   @id @default(uuid())
  number           Int
  name             String
  description      String?
  procurementType  String
  deliveryPlace    String?
  unit             String?
  quantity         String?
  estimatedAmount  Float?
  totalAmount      Float?
  year             Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([number, year])
  @@index([year])
  @@index([procurementType])
}

model PurchasePlan {
  id        String   @id @default(uuid())
  year      Int      @unique
  title     String
  fileUrl   String?
  createdAt DateTime @default(now())

  @@index([year])
}

// ─── Supplier Forms ───────────────────────────────────────────────────────────

model SupplierForm {
  id            String             @id @default(uuid())
  bin           String             @db.Char(12)
  companyName   String
  contactPerson String
  position      String?
  phone         String
  email         String
  supplyCategory String
  description   String
  status        SupplierFormStatus @default(NEW)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([status])
  @@index([bin])
  @@index([createdAt])
}

// ─── Contact Forms ────────────────────────────────────────────────────────────

model ContactFormSubmission {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ─── Pages (CMS-managed static pages) ────────────────────────────────────────

model Page {
  id           String            @id @default(uuid())
  slug         String            @unique // "home" | "about" | "services" | "esg" | "contacts"
  isPublished  Boolean           @default(true)
  blocks       PageBlock[]
  translations PageTranslation[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([slug])
}

model PageBlock {
  id        String   @id @default(uuid())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type      String   // hero | text_image | kpi | quote | pdf_list | contacts_block
  sortOrder Int
  content   Json     // Per-block-type JSON structure
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageId, sortOrder])
}

model PageTranslation {
  id             String   @id @default(uuid())
  pageId         String
  page           Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  lang           Lang
  title          String
  seoTitle       String?
  seoDescription String?
  ogImageUrl     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([pageId, lang])
  @@index([pageId])
}

// ─── Vacancies & HR ───────────────────────────────────────────────────────────

model Vacancy {
  id           String               @id @default(uuid())
  department   String               // "Локомотивные бригады" | "Диспетчерская служба" | etc.
  employment   String               @default("Полная занятость")
  location     String               @default("Казахстан")
  salaryFrom   Int?
  salaryTo     Int?
  status       VacancyStatus        @default(DRAFT)
  sortOrder    Int                  @default(0)
  translations VacancyTranslation[]
  applications ResumeApplication[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([status])
  @@index([department])
  @@index([sortOrder])
}

model VacancyTranslation {
  id               String   @id @default(uuid())
  vacancyId        String
  vacancy          Vacancy  @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  lang             Lang
  title            String
  description      String   @db.Text
  requirements     String   @db.Text
  responsibilities String   @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([vacancyId, lang])
  @@index([vacancyId])
}

model ResumeApplication {
  id          String       @id @default(uuid())
  vacancyId   String?
  vacancy     Vacancy?     @relation(fields: [vacancyId], references: [id], onDelete: SetNull)
  fullName    String
  phone       String
  email       String
  coverLetter String?      @db.Text
  resumeUrl   String?
  status      ResumeStatus @default(NEW)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status])
  @@index([vacancyId])
  @@index([createdAt])
}

// ─── Survey Submissions ───────────────────────────────────────────────────────

enum SurveyType {
  transportation
  forwarding
}

model SurveySubmission {
  id          String     @id @default(uuid())
  surveyType  SurveyType
  company     String
  contactName String
  phone       String
  email       String
  answers     Json       // { q_overall: 4, q_timing: 5, q_nps: 9, q_comment: "..." }
  createdAt   DateTime   @default(now())

  @@index([surveyType])
  @@index([createdAt])
}

// ─── App Settings ─────────────────────────────────────────────────────────────

model Setting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

// ─── Offices / Contacts ───────────────────────────────────────────────────────

model Office {
  id         String   @id @default(uuid())
  cityRu     String
  cityKz     String
  addressRu  String
  addressKz  String
  phone      String
  email      String
  department String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([sortOrder])
}
