# ─── Database ─────────────────────────────────────────────────────────────────
# В Docker: хост = postgres (имя сервиса compose). Вне Docker: localhost
DATABASE_URL="postgresql://npk:CHANGE_ME@postgres:5432/npk_cms"
POSTGRES_DB=npk_cms
POSTGRES_USER=npk
POSTGRES_PASSWORD=CHANGE_ME

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_64_CHAR_HEX_STRING
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_64_CHAR_HEX_STRING
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── MinIO ────────────────────────────────────────────────────────────────────
# В Docker: minio. Вне Docker: localhost
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=CHANGE_ME_MINIO_PASSWORD
MINIO_BUCKET=npk-media
# Public URL where MinIO files are accessible
MINIO_PUBLIC_URL=https://halykparty.kz/media

# ─── hCaptcha ─────────────────────────────────────────────────────────────────
HCAPTCHA_SECRET=CHANGE_ME_HCAPTCHA_SECRET_KEY

# ─── YouTube Data API v3 (секция «Народное медиа» на главной) ─────────────────
# Ключ — в Google Cloud Console (console.cloud.google.com): создать/выбрать
# проект → APIs & Services → Library → включить "YouTube Data API v3" →
# Credentials → Create Credentials → API key. Доступ к самому каналу НЕ нужен —
# ключ читает только публичные данные. Без ключа секция покажет статичный фолбэк.
YOUTUBE_API_KEY=
# Необязательно — по умолчанию используется канал НПК (см. youtube.controller.ts)
YOUTUBE_CHANNEL_ID=UCYq_KOlsxp8H2r3GIq6hWtA

# ─── 2ГИС Suggest API (автоподсказки адреса на /vstupit, шаг «Данные») ────────
# Получить ключ: dev.2gis.ru → зарегистрироваться → создать проект → выбрать
# продукт «Suggest API» (бесплатный тариф для старта). Без ключа подсказки
# просто не показываются — поле адреса работает как обычный текстовый инпут.
TWOGIS_API_KEY=

# ─── Google Calendar API (видеоприём через Google Meet) ───────────────────────
# Заполняет партнёр-разработчик после подключения интеграции — см.
# docs/GOOGLE_MEET_SETUP.md за пошаговой инструкцией. Без этих переменных
# создание видеозвонка в CMS сохраняет данные (депутат/время), но помечает
# встречу статусом PENDING вместо SCHEDULED — см. googleCalendar.ts.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=

# ─── SMS-провайдер (подпись заявления о вступлении, напоминания о видеоприёме) ─
# Заполняет партнёр-разработчик после выбора провайдера вместе с заказчиком
# (Mobizon/SMS.ru/Twilio и т.п.) — единственная точка входа: sendSms() в
# cms/packages/api/src/lib/sms.ts. Без ключа код сейчас в dev-режиме: код
# подтверждения не отправляется, а пишется в лог сервера (logger.warn) —
# форма вступления и напоминания при этом полностью тестируемы локально.
SMS_API_KEY=
SMS_API_URL=
SMS_SENDER_NAME=

# ─── Telegram (автопубликация новостей) ──────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=@halykparty

# ─── Claude (AI-помощник и база знаний) ──────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5190,https://halykparty.kz,https://www.halykparty.kz,https://cms.halykparty.kz
# Адрес сайта (app/) — используется для ссылки /verify/[id] в QR-коде партбилета
SITE_URL=http://localhost:3000

# ─── Email (for form submission notifications) ────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@halykparty.kz
SMTP_PASS=CHANGE_ME_APP_PASSWORD
SMTP_FROM="НПК <noreply@halykparty.kz>"
NOTIFICATION_EMAIL=office@halykparty.kz

# ─── CMS Frontend (Vite) ──────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3001
VITE_HCAPTCHA_SITE_KEY=CHANGE_ME_HCAPTCHA_SITE_KEY
# Resend — основной канал транзакционных писем (включая партбилет).
RESEND_API_KEY=
RESEND_FROM="НПК <noreply@halykpartiyasy.kz>"
MINIO_MEMBERSHIP_CARDS_BUCKET=membership-cards
