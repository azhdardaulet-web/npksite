{
  "name": "dar-rail-cms",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev:api": "pnpm --filter api dev",
    "dev:cms": "pnpm --filter cms dev",
    "build": "pnpm --filter shared build && pnpm --filter api build && pnpm --filter cms build",
    "db:migrate": "pnpm --filter api db:migrate",
    "db:seed": "pnpm --filter api db:seed"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "dependencies": {
    "@types/jszip": "^3.4.0",
    "jszip": "^3.10.1"
  }
}
